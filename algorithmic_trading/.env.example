# Copy to algorithmic_trading/.env. Keep real credentials out of version control.
FINNHUB_API_KEY=your_key_here
ALPHA_VANTAGE_API_KEY=
DATABASE_URL=sqlite:///trading.db
APP_PORT=5001
QUOTE_SAMPLE_INTERVAL_SECONDS=30
QUOTE_SAMPLE_MAX_PER_CYCLE=25
# Local Ollama model; install it separately with ollama pull.
QUANTIFY_CHAT_MODEL=qwen3:8b
