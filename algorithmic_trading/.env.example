# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file or put a real key in README.md.

# Get a Finnhub API key at https://finnhub.io/
FINNHUB_API_KEY=your_key_here

# Local quote snapshots are collected twice per minute while run.py is active.
QUOTE_SAMPLE_INTERVAL_SECONDS=30

# Rate-safety cap. Longer watchlists rotate across successive cycles.
QUOTE_SAMPLE_MAX_PER_CYCLE=25

# Port 5000 is commonly occupied by macOS AirPlay Receiver.
APP_PORT=5001

# Legacy/optional: only needed for the old historical-data importer.
ALPHA_VANTAGE_API_KEY=

# Optional: defaults to local sqlite if not set
DATABASE_URL=sqlite:///trading.db
